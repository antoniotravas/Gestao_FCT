# Bloqueia acesso direto a ficheiros sensíveis (Apache e LiteSpeed)
Options -Indexes
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|db|md)$|^config(\.sample)?\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(lib|data|\.git)(/|$) - [F,L]
  RewriteRule (^|/)\.git(ignore|attributes)?$ - [F,L]
  RewriteRule (^|/)config(\.sample)?\.php$ - [F,L]
  RewriteRule \.(sqlite|sqlite-wal|sqlite-shm|db|md)$ - [F,L]
</IfModule>

# LiteSpeed (alguns alojamentos ignoram as regras acima): mod_alias
RedirectMatch 403 ^/(lib|data)(/|$)
# Atualização por git (git pull no servidor): a pasta .git não pode ser lida pelo browser
RedirectMatch 403 (^|/)\.git
RedirectMatch 403 /config(\.sample)?\.php$
RedirectMatch 403 \.(sqlite|sqlite-wal|sqlite-shm|db|md)$

# A página principal não fica em cache (os ficheiros .js/.css têm ?v= no endereço)
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
